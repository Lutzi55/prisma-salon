@{
    var codigo = ViewData["Codigo"] as int? ?? 500;
    var (titulo, texto) = codigo switch
    {
        404 => ("No encontramos esa página", "Puede que el enlace esté mal escrito o que la página ya no exista."),
        403 => ("No tenés permiso para ver esto", "Si creés que es un error, iniciá sesión con otra cuenta."),
        400 => ("No pudimos procesar el pedido", "Recargá la página e intentá de nuevo."),
        _ => ("Algo salió mal", "Ocurrió un error inesperado. Ya quedó registrado; probá de nuevo en unos minutos.")
    };
    ViewData["Title"] = titulo;
}

<section class="error-pagina">
    <p class="error-codigo">Error @codigo</p>
    <h1>@titulo</h1>
    <p>@texto</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Volver al inicio</a>
</section>
