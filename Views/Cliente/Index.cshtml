@model IEnumerable<Cliente>
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Clientes</h2>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo cliente</a>
</div>
<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead><tr><th>Razón social</th><th>Domicilio</th><th>Teléfono</th><th></th></tr></thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.RazonSocialApellido</td>
                    <td>@c.DomicilioLegal</td>
                    <td>@c.Telefono</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@c.IdCliente" class="btn btn-sm btn-outline-secondary">Editar</a>
                        <form asp-action="Delete" asp-route-id="@c.IdCliente" method="post" class="d-inline form-eliminar">
                            <button class="btn btn-sm btn-outline-danger">Eliminar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>