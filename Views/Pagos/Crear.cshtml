@model PagoVM
@{
    ViewData["Title"] = "Registrar pago";
}
<h2>Registrar pago</h2>
<form asp-action="Create" method="post" enctype="multipart/form-data" class="col-md-6">
    <input type="hidden" asp-for="IdContrato" />
    <div class="mb-3">
        <label asp-for="Monto" class="form-label"></label>
        <input asp-for="Monto" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="Monto" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="FechaPago" class="form-label"></label>
        <input asp-for="FechaPago" class="form-control" />
    </div>
    <div class="mb-4">
        <label asp-for="Comprobante" class="form-label">Comprobante (JPG o PNG)</label>
        <input asp-for="Comprobante" type="file" accept="image/png,image/jpeg" class="form-control" />
        <span asp-validation-for="Comprobante" class="text-danger"></span>
    </div>
    <button class="btn btn-success">Guardar pago</button>
    <a asp-action="Index" asp-route-idContrato="@Model.IdContrato" class="btn btn-link">Cancelar</a>
</form>
@section Scripts {
<partial name="_ValidationScriptsPartial" />
 }