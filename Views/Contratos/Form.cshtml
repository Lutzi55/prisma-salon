@model ContratoVM
@{
    var shows = (List<ShowStaff>)ViewData["Shows"]!;
    var emps = (List<Empleado>)ViewData["Empleados"]!;
    var paquetes = (List<PaqueteEvento>)ViewData["Paquetes"]!;
    var categorias = (List<CategoriaOpcion>)ViewData["Categorias"]!;
    var nuevo = Model.IdContrato == 0;
    var es = new System.Globalization.CultureInfo("es-AR");
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    ViewData["Title"] = nuevo ? "Nuevo contrato" : "Editar contrato";
}

<a class="volver" asp-action="@(nuevo ? "Index" : "Detalle")" asp-route-id="@(nuevo ? null : Model.IdContrato)">← Volver</a>
<h2>@ViewData["Title"]</h2>
<p class="crud-descripcion">Elegí el cliente, el paquete y lo que se personalizó. El valor se calcula solo; si acordaron otro precio, podés cambiarlo.</p>

<form asp-action="@(nuevo ? "Create" : "Edit")" method="post" enctype="multipart/form-data" class="form-contrato" id="formContrato">
    <input type="hidden" asp-for="IdContrato" />
    <input type="hidden" asp-for="RutaContratoPdf" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <fieldset class="bloque">
        <legend>1. Cliente, paquete y fecha</legend>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="IdCliente" class="form-label"></label>
                <select asp-for="IdCliente" asp-items="@(ViewData["IdCliente"] as SelectList)" class="form-select">
                    <option value="">Seleccioná...</option>
                </select>
                <span asp-validation-for="IdCliente" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="IdPaquete" class="form-label"></label>
                <select asp-for="IdPaquete" class="form-select" id="selPaquete">
                    <option value="">Seleccioná...</option>
                    @foreach (var p in paquetes)
                    {
                        <option value="@p.IdPaquete" data-precio="@p.Precio.ToString(inv)" selected="@(Model.IdPaquete == p.IdPaquete)">@p.Nombre ($ @p.Precio.ToString("N0", es))</option>
                    }
                </select>
                <span asp-validation-for="IdPaquete" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="FechaEvento" class="form-label"></label>
                <input asp-for="FechaEvento" class="form-control" />
                <span asp-validation-for="FechaEvento" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="FormaPago" class="form-label"></label>
                <select asp-for="FormaPago" class="form-select">
                    <option value="">Seleccioná...</option>
                    <option>Transferencia</option>
                    <option>Cheque</option>
                    <option>Efectivo</option>
                    <option>Depósito</option>
                    <option>Cuotas</option>
                </select>
                <span asp-validation-for="FormaPago" class="text-danger"></span>
            </div>
        </div>
    </fieldset>

    <fieldset class="bloque">
        <legend>2. Personalización (cobro extra)</legend>
        <span asp-validation-for="OpcionesIds" class="text-danger d-block mb-2"></span>
        @foreach (var cat in categorias.Where(c => c.Opciones.Any()))
        {
            <div class="grupo-opc" data-unica="@(!cat.EsMultiple ? "1" : "0")">
                <h4>@cat.Nombre <small>@(cat.EsMultiple ? "se pueden elegir varias" : "se elige una")</small></h4>
                <div class="opciones-check">
                    @foreach (var o in cat.Opciones.OrderBy(o => o.PrecioAdicional))
                    {
                        <label class="opcion-check">
                            <input type="checkbox" name="OpcionesIds" value="@o.IdOpcion" data-precio="@o.PrecioAdicional.ToString(inv)" checked="@Model.OpcionesIds.Contains(o.IdOpcion)" />
                            <span>@o.Nombre</span>
                            <b>@(o.PrecioAdicional == 0 ? "Incluida" : "+ $ " + o.PrecioAdicional.ToString("N0", es))</b>
                        </label>
                    }
                </div>
            </div>
        }
        @if (!categorias.Any(c => c.Opciones.Any()))
        {
            <p class="vacio">No hay opciones cargadas. Agregalas desde el menú Opciones.</p>
        }
    </fieldset>

    <fieldset class="bloque">
        <legend>3. Valor del contrato</legend>
        <div class="valor-sugerido">
            <div>
                <small>Paquete + opciones elegidas</small>
                <b id="valorSugerido">$ 0</b>
            </div>
            <button type="button" class="btn btn-outline-dark btn-sm" id="usarSugerido">Usar este valor</button>
        </div>
        <div class="col-md-6">
            <label asp-for="ValorRealAcordado" class="form-label"></label>
            <input asp-for="ValorRealAcordado" type="number" step="0.01" class="form-control" id="valorAcordado" />
            <span asp-validation-for="ValorRealAcordado" class="text-danger"></span>
        </div>
    </fieldset>

    <fieldset class="bloque">
        <legend>4. Shows y personal (opcional)</legend>
        <div class="row g-4">
            <div class="col-md-6">
                <label class="form-label">Shows contratados</label>
                @foreach (var s in shows)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="ShowsIds" value="@s.IdShow" id="s@(s.IdShow)" checked="@Model.ShowsIds.Contains(s.IdShow)" />
                        <label class="form-check-label" for="s@(s.IdShow)">@s.NombreShow (@s.TipoShow)</label>
                    </div>
                }
                @if (!shows.Any()) { <div class="form-text">No hay shows cargados.</div> }
            </div>
            <div class="col-md-6">
                <label class="form-label">Personal asignado</label>
                @foreach (var e in emps)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="EmpleadosIds" value="@e.IdEmpleado" id="e@(e.IdEmpleado)" checked="@Model.EmpleadosIds.Contains(e.IdEmpleado)" />
                        <label class="form-check-label" for="e@(e.IdEmpleado)">@e.NombreApellido (@e.Puesto)</label>
                    </div>
                }
                @if (!emps.Any()) { <div class="form-text">No hay empleados cargados.</div> }
                <div class="mt-3">
                    <label asp-for="HoraCitacion" class="form-label"></label>
                    <input asp-for="HoraCitacion" type="time" class="form-control" />
                    <span asp-validation-for="HoraCitacion" class="text-danger"></span>
                </div>
            </div>
        </div>
    </fieldset>

    <fieldset class="bloque">
        <legend>5. Contrato en PDF (opcional)</legend>
        <p class="form-text">Solo si ya tenés el contrato firmado en papel. Si no, después lo redactás desde la ficha y el cliente lo firma en la web.</p>
        <input asp-for="ArchivoPdf" type="file" accept="application/pdf" class="form-control" />
        @if (!string.IsNullOrEmpty(Model.RutaContratoPdf))
        {
            <div class="form-text">Ya hay un PDF cargado. Si subís otro, lo reemplaza.</div>
        }
        <span asp-validation-for="ArchivoPdf" class="text-danger"></span>
    </fieldset>

    <button type="submit" class="btn btn-primary">@(nuevo ? "Crear contrato" : "Guardar cambios")</button>
    <a asp-action="@(nuevo ? "Index" : "Detalle")" asp-route-id="@(nuevo ? null : Model.IdContrato)" class="btn btn-link">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/personalizar.js" asp-append-version="true"></script>
    <script>
        Personalizar.iniciar({
            form: document.getElementById('formContrato'),
            paquete: document.getElementById('selPaquete'),
            total: document.getElementById('valorSugerido'),
            alUsar: { boton: document.getElementById('usarSugerido'), campo: document.getElementById('valorAcordado') }
        });
    </script>
}
