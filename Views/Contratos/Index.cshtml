@model List<Contrato>
@{
    ViewData["Title"] = "Contratos";
    var es = new System.Globalization.CultureInfo("es-AR");
    string M(decimal d) => "$ " + d.ToString("N0", es);

    var grupos = new[]
    {
        ("Para hacer ahora", "Contratos que esperan una acción del salón.",
            Model.Where(c => EtapaContrato.TocaAlAdmin(EtapaContrato.Actual(c))).ToList()),
        ("Esperando al cliente", "El cliente tiene que firmar o pagar. No hace falta que hagas nada.",
            Model.Where(c => EtapaContrato.TocaAlCliente(EtapaContrato.Actual(c))).ToList()),
        ("Completos", "Contratos firmados y pagados en su totalidad.",
            Model.Where(c => EtapaContrato.Actual(c) == EtapaContrato.Paso.Completo).ToList())
    };
}

<div class="contratos-cab">
    <div>
        <h2>Contratos</h2>
        <p class="crud-descripcion">
            Cada contrato avanza en cinco pasos: el pedido (lo arma el cliente o lo cargás vos), el contrato que redactás y enviás,
            la firma del cliente, el pago con su comprobante y, al final, listo para el evento.
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Calendario" asp-action="Index" class="btn btn-outline-dark">Ver calendario</a>
        <a asp-action="Create" class="btn btn-primary">Nuevo contrato</a>
    </div>
</div>

@if (!Model.Any())
{
    <p class="vacio">Todavía no hay contratos. Los pedidos que hagan los clientes desde «Personalizar paquete» van a aparecer acá.</p>
}

@foreach (var (titulo, ayuda, lista) in grupos)
{
    if (!lista.Any()) { continue; }
    <section class="grupo-contratos">
        <h3>@titulo <span class="contador">@lista.Count</span></h3>
        <p class="sub">@ayuda</p>

        @foreach (var c in lista)
        {
            var paso = EtapaContrato.Actual(c);
            var revisar = c.Pagos.Where(p => p.Estado == "Pendiente").ToList();
            <article class="contrato-fila @(EtapaContrato.TocaAlAdmin(paso) ? "requiere" : "")">
                <div class="contrato-quien">
                    <a asp-action="Detalle" asp-route-id="@c.IdContrato" class="contrato-nombre">@c.Cliente.RazonSocialApellido</a>
                    <span>@c.Paquete.Nombre</span>
                    <span>Evento del @c.FechaEvento.ToString("dd/MM/yyyy") · @M(c.ValorRealAcordado)</span>
                    @if (c.PedidoPorCliente)
                    {
                        <span class="etiqueta-pedido">Pedido del cliente</span>
                    }
                </div>

                <div class="contrato-avance">
                    <partial name="_Etapas" model="c" />
                    <p class="contrato-paso">@EtapaContrato.TextoAdmin(paso)</p>
                </div>

                <div class="contrato-accion">
                    @switch (paso)
                    {
                        case EtapaContrato.Paso.RedactarContrato:
                        case EtapaContrato.Paso.EnviarContrato:
                            <a asp-action="Redactar" asp-route-id="@c.IdContrato" class="btn btn-primary btn-sm">@(paso == EtapaContrato.Paso.RedactarContrato ? "Redactar contrato" : "Revisar y enviar")</a>
                            break;
                        case EtapaContrato.Paso.EnviarRecibo:
                            <a asp-controller="Pagos" asp-action="Solicitar" asp-route-idContrato="@c.IdContrato" class="btn btn-primary btn-sm">Enviar recibo de pago</a>
                            break;
                        case EtapaContrato.Paso.CobrarEnSalon:
                            <a asp-action="Detalle" asp-route-id="@c.IdContrato" asp-fragment="pagos" class="btn btn-primary btn-sm">Registrar cobro en el salón</a>
                            break;
                        case EtapaContrato.Paso.RevisarComprobante:
                            <a asp-action="Detalle" asp-route-id="@c.IdContrato" asp-fragment="pagos" class="btn btn-primary btn-sm">Revisar comprobante (@M(revisar.Sum(p => p.Monto)))</a>
                            break;
                    }
                    <a asp-action="Detalle" asp-route-id="@c.IdContrato" class="btn btn-outline-dark btn-sm">Ver ficha</a>
                </div>
            </article>
        }
    </section>
}
